#compdef revoot

_revoot() {
  local -a commands
  commands=(
    'config:Explain effective review configuration'
    'init:Generate integration configuration'
    'doctor:Report host and product readiness'
    'review:Review the current local change or a code-host change request'
    'scan:Prepare or run a bounded local source scan'
    'delegate:Emit provider-free delegation metadata'
    'rules:Inspect effective rule precedence'
    'mcp:Run the read-only stdio MCP server'
    'completions:Generate shell completions'
    'version:Print the Revoot version'
    'help:Show command help'
  )
  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi
  case $words[2] in
    review) _arguments '--base[Local comparison base]:git ref:' '--ci[Use code-host CI context]' '--mr[GitLab merge request IID]:iid:' '--pr[GitHub pull request number]:number:' '--repo[GitHub target repository]:owner/repository:' '--preview[Show provider-free preparation]' '--effort[Review effort]:effort:(low medium high)' '--max-parallel-groups[Concurrent groups]:count:(1 2 3 4 5 6 7 8)' '--format[Report format]:format:(human json sarif)' '--output[Write report]:path:_files' '--help[Show help]' ;;
    scan) _arguments '*--path[Limit scan to path]:path:_files' '--include-untracked[Include local untracked files]' '--preview[Show provider-free scan plan]' '--format[Output format]:format:(human json sarif)' '--help[Show help]' ;;
    delegate) _arguments '1:operation:(preview rule)' '*:repository path:_files' '--help[Show help]' ;;
    rules) _arguments '1:operation:(check)' '*:repository path:_files' '--json[Emit JSON]' '--help[Show help]' ;;
    mcp) _arguments '1:operation:(serve)' ;;
    doctor) _arguments '--json[Emit JSON]' '--help[Show help]' ;;
    completions) _values 'shell' bash zsh fish ;;
    init) _arguments '1:target:(gitlab github)' '--component[GitLab component path]:path:' '--version[GitLab component version]:version:' '--image[Immutable worker image digest]:image:' '--provider[Provider]:provider:' '--model[Model]:model:' '--fork-behavior[Fork policy]:policy:(report-only skip trusted-target)' '--help[Show help]' ;;
    config) _arguments '1:operation:(explain)' '--json[Emit JSON]' '--base-config[Base config]:path:_files' '--config[Repository config]:path:_files' '--provider[Provider]:provider:' '--model[Model]:model:' '--publish[Enable publication]' '--no-publish[Disable publication]' '--help[Show help]' ;;
  esac
}

_revoot "$@"
